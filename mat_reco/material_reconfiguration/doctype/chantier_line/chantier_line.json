   "default": "1",
   "in_list_view": 1
  },
  {
   "fieldname": "uom",
   "label": "Unité",
   "fieldtype": "Link",
   "options": "UOM"
  },
  {
   "fieldname": "rate",
   "label": "Prix unitaire proposé",
   "fieldtype": "Currency",
   "options": "currency",
   "in_list_view": 1
  },
  {
   "fieldname": "rate_set",
   "label": "Prix confirmé",
   "fieldtype": "Check",
   "default": "0"
  },
  {
   "fieldname": "price_source",
   "label": "Origine du prix",
   "fieldtype": "Select",
   "options": "Manual\nPrice List",
   "read_only": 1
