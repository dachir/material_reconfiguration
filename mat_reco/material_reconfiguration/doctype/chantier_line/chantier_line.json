  {
   "fieldname": "sale_item",
   "label": "Article vendu directement",
   "fieldtype": "Link",
   "options": "Item"
  }
 ],
 "field_order": [
  "line_id",
  "repere",
  "work_type",
  "excluded_type_extras",
  "designation",
  "section",
  "proposed_item",
  "length_mm",
  "width_mm",
  "thickness_mm",
  "qty",
  "uom",
  "rate",
  "rate_set",
  "price_source"
 ],
