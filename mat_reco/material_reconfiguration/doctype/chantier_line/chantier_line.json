   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "section",
   "label": "Section",
   "fieldtype": "Link",
   "options": "Chantier Section"
  },
  {
   "fieldname": "proposed_item",
   "label": "Article existant (facultatif)",
   "fieldtype": "Link",
   "options": "Item"
  },
  {
   "fieldname": "length_mm",
   "label": "Longueur proposée (mm)",
   "fieldtype": "Float"
  },
  {
   "fieldname": "width_mm",
   "label": "Hauteur proposée (mm)",
   "fieldtype": "Float"
  },
  {
   "fieldname": "thickness_mm",
   "label": "Épaisseur proposée (mm)",
   "fieldtype": "Float"
