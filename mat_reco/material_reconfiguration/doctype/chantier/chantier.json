{
 "doctype": "DocType",
 "name": "Chantier",
 "module": "Material Reconfiguration",
 "engine": "InnoDB",
 "autoname": "YY.CHANT.MM.#####",
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "reference",
   "label": "Référence",
   "fieldtype": "Data",
   "read_only": 1,
   "no_copy": 1,
   "description": "Générée automatiquement à l’enregistrement : YYCHANTMM#####.",
   "reqd": 1,
   "unique": 1
  },
  {
   "fieldname": "designation",
   "label": "Désignation",
   "fieldtype": "Data",
   "reqd": 1
  },
  {
   "fieldname": "company",
   "label": "Société",
   "fieldtype": "Link",
   "options": "Company",
   "reqd": 1
  },
  {
   "fieldname": "customer",
   "label": "Client",
   "fieldtype": "Link",
   "options": "Customer",
   "reqd": 1
  },
  {
   "fieldname": "responsible",
   "label": "Responsable",
   "fieldtype": "Link",
   "options": "User"
  },
  {
   "fieldname": "expected_start_date",
   "label": "Début prévu",
   "fieldtype": "Date"
  },
  {
   "fieldname": "expected_end_date",
   "label": "Fin de fabrication prévue",
   "fieldtype": "Date"
  },
  {
   "fieldname": "status",
   "label": "État du dossier",
   "fieldtype": "Select",
   "options": "Preparation\nQuotation\nConfirmed\nIn Production\nCompleted\nOn Hold\nCancelled",
   "default": "Preparation"
  },
  {
   "fieldname": "description",
   "label": "Description",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "currency",
   "label": "Devise",
   "fieldtype": "Link",
   "options": "Currency"
  },
  {
   "fieldname": "selling_price_list",
   "label": "Liste de prix",
   "fieldtype": "Link",
   "options": "Price List"
  },
  {
   "fieldname": "taxes_and_charges",
   "label": "Modèle de taxes",
   "fieldtype": "Link",
   "options": "Sales Taxes and Charges Template"
  },
  {
   "fieldname": "lines",
   "label": "Ouvrages proposés",
   "fieldtype": "Table",
   "options": "Chantier Line"
  },
  {
   "fieldname": "technical_study",
   "label": "Fiche technique validée",
   "fieldtype": "Link",
   "options": "Chantier Technical Study",
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "commercial_hash",
   "label": "Empreinte commerciale approuvée",
   "fieldtype": "Data",
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "terms",
   "label": "Conditions commerciales",
   "fieldtype": "Text Editor"
  },
  {
   "fieldname": "amended_from",
   "label": "Révision précédente",
   "fieldtype": "Link",
   "options": "Chantier",
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "commercial_extras",
   "label": "Services et accessoires",
   "fieldtype": "Table",
   "options": "Chantier Commercial Extra"
  },
  {
   "fieldname": "ft_active",
   "label": "FT activée",
   "fieldtype": "Check",
   "default": "0",
   "read_only": 1,
   "no_copy": 1,
   "allow_on_submit": 1
  },
  {
   "fieldname": "ft_activation_key",
   "label": "Clé activation FT",
   "fieldtype": "Data",
   "read_only": 1,
   "hidden": 1,
   "no_copy": 1,
   "allow_on_submit": 1
  },
  {
   "fieldname": "workflow_version",
   "label": "Version du parcours",
   "fieldtype": "Int",
   "default": "0",
   "hidden": 1,
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "work_types",
   "label": "Types d’ouvrage",
   "fieldtype": "Table",
   "options": "Chantier Work Type"
  },
  {
   "fieldname": "downstream_started",
   "label": "Déjà utilisé commercialement ou en atelier",
   "fieldtype": "Check",
   "hidden": 1,
   "read_only": 1,
   "no_copy": 1,
   "allow_on_submit": 1
  },
  {
   "fieldname": "discount_mode",
   "label": "Type de remise",
   "fieldtype": "Select",
   "options": "Pourcentage\nMontant",
   "default": "Pourcentage",
   "insert_after": "responsible"
  },
  {
   "fieldname": "discount_value",
   "label": "Remise",
   "fieldtype": "Float",
   "default": "0"
  }
 ],
 "field_order": [
  "reference",
  "designation",
  "company",
  "customer",
  "responsible",
  "expected_start_date",
  "expected_end_date",
  "status",
  "description",
  "currency",
  "selling_price_list",
  "taxes_and_charges",
  "workflow_version",
  "work_types",
  "lines",
  "ft_active",
  "ft_activation_key",
  "technical_study",
  "commercial_hash",
  "terms",
  "amended_from",
  "downstream_started",
  "discount_mode",
  "discount_value"
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1,
   "export": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1
  },
  {
   "role": "Sales Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1,
   "export": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1
  },
  {
   "role": "Sales User",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1,
   "export": 1
  },
  {
   "role": "Stock Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1,
   "export": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1
  },
  {
   "role": "Stock User",
   "read": 1,
   "report": 1
  }
 ],
 "title_field": "designation",
 "search_fields": "reference,designation",
 "is_submittable": 1,
 "allow_import": 1
}
